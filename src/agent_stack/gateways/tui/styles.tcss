/* agent-stack TUI stylesheet. Colours are theme variables only (see theme.py):
   depth comes from three layers, $background < $surface < $panel, not from borders. */

Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
}

/* ── header ─────────────────────────────────────────────────────────────── */
HeaderBar {
    height: 1;
    padding: 0 2;
    background: $surface;
}
#brand { width: auto; color: $primary; text-style: bold; }
#title {
    width: 1fr;
    padding: 0 2;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#run-state { width: auto; }
#model { width: auto; margin-left: 2; color: $text-muted; }

/* ── layout ─────────────────────────────────────────────────────────────── */
#body { height: 1fr; }
#conversation { width: 1fr; height: 1fr; }
#chat {
    height: 1fr;
    padding: 0 2;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
}

/* ── conversation rows ──────────────────────────────────────────────────── */
.user-message {
    margin: 1 0 0 0;
    padding: 0 1;
    background: $panel;
    border-left: thick $primary;
    color: $text;
}
.agent-message { margin: 1 0 0 0; padding: 0 0 0 2; }
.subagent-row { height: 1; margin: 0; }

.notice {
    margin: 1 0 0 0;
    padding: 0 1;
    background: $error-muted;
    border-left: thick $error;
    color: $text;
}

#welcome {
    margin: 2 0 0 0;
    padding: 1 2;
    background: $surface;
    border-left: thick $primary;
}

/* Markdown: headings colour-coded by level, code on a raised surface */
Markdown { background: transparent; margin: 0; padding: 0; }
MarkdownH1, MarkdownH2, MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6 {
    background: transparent;
    text-align: left;
    content-align: left middle;
    margin: 1 0 0 0;
    padding: 0;
    border: none;
}
MarkdownH1 { color: $primary; text-style: bold; }
MarkdownH2 { color: $secondary; text-style: bold; }
MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6 { color: $accent; text-style: bold; }
MarkdownParagraph { margin: 0 0 1 0; }
MarkdownBulletList MarkdownParagraph, MarkdownOrderedList MarkdownParagraph { margin: 0; }
MarkdownBlock > .code_inline { background: $panel; color: $accent; }
MarkdownFence {
    background: $surface;
    margin: 0 0 1 0;
    padding: 0 2;
}
MarkdownBlockQuote { background: transparent; border-left: thick $secondary; padding: 0 1; }

/* ── tool / thinking cards ──────────────────────────────────────────────── */
Disclosure { height: auto; margin: 1 0 0 0; background: $surface; }
Disclosure.-think { background: transparent; margin-top: 1; }
Disclosure.-failed { border-left: thick $error; }
DisclosureHeader { height: 1; padding: 0 1; }
DisclosureHeader:hover { background: $panel; }
DisclosureHeader:focus { background: $panel; text-style: bold; }
.dh-main { width: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }
.dh-meta { width: auto; padding-left: 2; }
.dh-body { display: none; height: auto; padding: 0 2 1 3; }
Disclosure.-open .dh-body { display: block; }

/* ── composer ───────────────────────────────────────────────────────────── */
#composer {
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    background: $panel;
    border-left: thick $primary;
}
#composer:focus-within { border-left: thick $accent; }
PromptArea {
    height: auto;
    min-height: 1;
    max-height: 8;
    padding: 0;
    border: none;
    background: transparent;
    color: $text;
}
PromptArea:focus { border: none; background: transparent; }
PromptArea > .text-area--placeholder { color: $text-muted; }
#hints { height: 1; padding: 0 4; color: $text-muted; }

/* ── sidebar ────────────────────────────────────────────────────────────── */
#sidebar { width: 34; height: 1fr; padding: 1 2; background: $surface; }
.sb-section { height: auto; margin-bottom: 1; }
#sb-spacer { height: 1fr; }

Footer { background: $surface; }

/* ── help overlay ───────────────────────────────────────────────────────── */
/* Modals share one look. Declared after `Screen`, whose background would otherwise replace
   the modal's dimmed backdrop. Cards differ only in width and the colour of the left bar. */
HelpScreen, ApprovalScreen, SessionPicker, RewindScreen, BranchesScreen {
    align: center middle;
    background: $background 70%;
}
#help-card, #approval-card, #picker-card, #changes-card {
    width: 80;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border-left: thick $primary;
}
#picker-card { width: 88; }
#picker-card.wide { width: 120; }
#changes-card { width: 110; max-height: 94%; }
#approval-card { border-left: thick $warning; }
#approval-what { margin-top: 1; }
#approval-detail { margin: 1 0; padding: 0 1; background: $panel; }
#picker-title { margin-bottom: 1; }
#picker-foot { margin-top: 1; }
#picker-list {
    height: auto;
    max-height: 30;
    padding: 0;
    border: none;
    background: transparent;
}
#picker-list > .option-list--option-highlighted { background: $panel; color: $text; text-style: bold; }
#changes-title { margin-bottom: 1; }
#changes-foot { margin-top: 1; }
#changes-list {
    height: auto;
    max-height: 8;
    padding: 0;
    border: none;
    background: transparent;
}
#changes-list > .option-list--option-highlighted { background: $panel; color: $text; text-style: bold; }
#changes-scroll { height: auto; max-height: 24; margin-top: 1; padding: 0 1; background: $panel; }
#help-title { margin-bottom: 1; }
.help-group { margin-bottom: 1; }

/* ── responsive: classes come from the app's breakpoints ────────────────── */
Screen.-wide #sidebar { width: 40; }
Screen.-narrow #sidebar { display: none; }
Screen.-narrow #model { display: none; }
Screen.-narrow #chat { padding: 0 1; }
Screen.-narrow #composer { margin: 1 1 0 1; }
Screen.-narrow #hints { padding: 0 2; }
Screen.-short #hints { display: none; }
Screen.-short #welcome { display: none; }
Screen.-short .user-message, Screen.-short .agent-message, Screen.-short Disclosure { margin-top: 0; }
/* the explicit ctrl+b override wins over the width default (declared last) */
Screen.-show-sidebar #sidebar { display: block; width: 30; }
Screen.-hide-sidebar #sidebar { display: none; }

/* ── slash-command completions, above the prompt ───────────────────────── */
#completions {
    display: none;
    height: auto;
    max-height: 12;
    padding: 0;
    margin-bottom: 1;
    border: none;
    background: $surface;
}
#completions > .option-list--option-highlighted { background: $panel; text-style: bold; }
#approval-note { margin-bottom: 1; }
