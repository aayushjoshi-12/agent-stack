# agent-stack environment template — copy to .env and fill in.
# Never commit .env.

# ── Model provider ────────────────────────────────────────────────────────────
# Any model id accepted by langchain's init_chat_model("<provider>:<model>").
OPENROUTER_API_KEY=

# Default agent model. Override per environment.
AGENT_STACK_MODEL=openrouter:deepseek/deepseek-v4-pro
# Asked when a model call keeps failing: a transient error (429, 5xx, timeout) is retried up to
# 4 times with backoff first; a bad model id or auth error goes to the fallback at once.
# AGENT_STACK_FALLBACK_MODEL=openrouter:z-ai/glm-5.3-flash
# Context window of the model above, in tokens (drives the TUI's usage meter)
# AGENT_STACK_CONTEXT_WINDOW=1000000
# Most tokens the model is shown per call (default 120000)
# AGENT_STACK_CONTEXT_BUDGET=120000
# Summarise the conversation and continue from the summary past this share of the budget
# (default 0.8); off turns automatic compaction off, /compact still works
# AGENT_STACK_COMPACT_AT=0.8

# ── Storage ───────────────────────────────────────────────────────────────────
# Root for session transcripts, artifacts and the sqlite index.
AGENT_STACK_WORKSPACE=./workspace
AGENT_STACK_DB=./workspace/agent.db

# ── Runtime limits ────────────────────────────────────────────────────────────
# No cap on model calls or tool calls: a run stops at its time limit (AGENT_STACK_MAX_RUNTIME,
# default 1800 s), the conversation budget, or when you stop it.
# Seconds one tool call may run (default 300); past it the call is stopped (a command's whole
# process group is killed), the model is told it timed out with the output so far, and the run
# goes on. run_command's own timeout argument never outlasts it. off (or 0) removes the cap.
# AGENT_STACK_TOOL_TIMEOUT=300

# Tools that pause for your approval before running (comma-separated; empty = none)
# AGENT_STACK_APPROVAL_TOOLS=run_command,write_file,edit_file,web_fetch,web_screenshot,monitor_start

# Who answers those approvals first: "ask" (you) or "auto" (a classifier decides what is safe and
# asks you only when it is unsure). Switch while running: shift+tab in the TUI prompt, /mode
# anywhere, /mode in Telegram, the header button on the web.
# AGENT_STACK_APPROVAL_MODE=auto
# What decides in auto mode when the built-in rules cannot. Default: Jev, OpenRouter's decision
# model, picks allow / deny / ask (~0.5 s, ~$0.00003 a call; under 70% sure it asks you).
# A chat model (provider:model) also works; "off" leaves only the rules, the rest is asked.
# AGENT_STACK_AUTO_MODEL=decisions:~typesafe/jev-latest

# Reaching outside the workspace folder: "ask" (default: allowed, but each such call needs your
# approval or an auto-mode verdict), "deny" (refused), or "allow" (unasked; only inside a container).
# AGENT_STACK_EXTERNAL_ACCESS=ask

# Telegram gateway (`agent-stack telegram`). The bot runs tools on this machine, so the
# allow-list of numeric Telegram user ids is required.
# TELEGRAM_BOT_TOKEN=
# AGENT_STACK_TELEGRAM_USERS=123456789
# Share the TUI's conversations instead of one identity per Telegram user:
# AGENT_STACK_TELEGRAM_PRINCIPAL=tui:local-user

# Web gateway (`agent-stack web`): the API runs tools on this machine, so it refuses to start
# without a secret of at least 16 characters. It binds to 127.0.0.1 by default.
# AGENT_STACK_WEB_TOKEN=
# AGENT_STACK_WEB_PORT=8765
# AGENT_STACK_WEB_PRINCIPAL=tui:local-user
# AGENT_STACK_WEB_ORIGINS=http://localhost:3000

# Rate limits for the web API and Telegram, per user (Telegram: per chat), per minute, all usable
# at once. MESSAGES counts what can spend model money (a message, a queued input, compact, rewind,
# branch); REQUESTS counts every other API call or button press. Over a limit the web API answers
# 429 with Retry-After and Telegram replies "Slow down" once. The web event stream is never
# limited. off removes a limit.
# AGENT_STACK_RATE_MESSAGES=30
# AGENT_STACK_RATE_REQUESTS=600

# Spend cap per conversation in USD (subagents included). A conversation at or over it starts no
# further run. Costs come from the provider's own figure (OpenRouter reports one per call); calls
# a provider does not price (e.g. a local model) are counted but never guessed at. Unset: no cap.
# AGENT_STACK_BUDGET_USD=2.00

# A cheaper model for side work: the read-only `explorer` subagent and conversation titles (the
# same split Claude Code makes with its Haiku-class model). Answers and file edits always use
# AGENT_STACK_MODEL. Unset: a known-good cheap OpenRouter model when the main model is on
# OpenRouter, otherwise no split. Set to `main` to turn the split off.
# AGENT_STACK_SMALL_MODEL=openrouter:z-ai/glm-5.3-flash

# Memory suggestions: after each run the small model (else the main model) proposes up to three
# facts to remember; you keep, edit or reject each (TUI /memories, the web panel, Telegram
# buttons). Nothing is stored until you keep it. Off by default: one more model call per run.
# AGENT_STACK_MEMORY_SUGGESTIONS=on

# OpenTelemetry traces (`uv sync --extra otel`): one trace per run with spans for model calls,
# tool calls (arguments redacted as in the audit log) and subagents. Off unless an OTLP endpoint
# is set or AGENT_STACK_OTEL=1 (then the OTLP/HTTP default, http://localhost:4318). The standard
# OTEL_* variables apply; the service name defaults to agent-stack.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20...
# OTEL_SERVICE_NAME=agent-stack
# AGENT_STACK_OTEL=1
# OTEL_TRACES_EXPORTER=console   # print spans to stdout instead of sending them
