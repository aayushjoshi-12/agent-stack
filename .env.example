# agent-stack environment template — copy to .env and fill in.
# Never commit .env.

# ── Model provider ────────────────────────────────────────────────────────────
# Any model id accepted by langchain's init_chat_model("<provider>:<model>").
OPENROUTER_API_KEY=

# Default agent model. Override per environment.
AGENT_STACK_MODEL=openrouter:z-ai/glm-5.3

# ── Storage ───────────────────────────────────────────────────────────────────
# Root for session transcripts, artifacts and the sqlite index.
AGENT_STACK_WORKSPACE=./workspace
AGENT_STACK_DB=./workspace/agent.db

# ── Runtime limits ────────────────────────────────────────────────────────────
AGENT_STACK_MAX_STEPS=50
AGENT_STACK_MAX_TOOL_CALLS=100
AGENT_STACK_MAX_CONCURRENT_TOOLS=8
